== schema: memories ==
CREATE TABLE `memories` (
  `id` bigint(20) NOT NULL AUTO_INCREMENT,
  `owner_id` varchar(64) NOT NULL,
  `title` varchar(120) NOT NULL,
  `content` text NOT NULL,
  `emotion` varchar(24) NOT NULL,
  `appraisal` int(11) NOT NULL,
  `status` varchar(16) NOT NULL DEFAULT 'pawned',
  `is_public` tinyint(4) NOT NULL DEFAULT '1',
  `embedding` VECTOR(384) NOT NULL,
  `created_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `redeemed_at` datetime DEFAULT NULL,
  PRIMARY KEY (`id`),
  FULLTEXT KEY `ft_mem` (`content`) WITH PARSER ik PARSER_PROPERTIES=(ik_mode="smart") BLOCK_SIZE 16384,
  VECTOR KEY `vidx_mem` (`embedding`) WITH (DISTANCE=COSINE, TYPE=HNSW, LIB=VSAG, M=16, EF_CONSTRUCTION=200, EF_SEARCH=64) BLOCK_SIZE 16384,
  KEY `idx_owner_status` (`owner_id`, `status`) BLOCK_SIZE 16384 LOCAL
) ORGANIZATION INDEX AUTO_INCREMENT = 31 DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0

== indexes: memories ==
  key=PRIMARY seq=1 column=id type=BTREE
  key=ft_mem seq=1 column=content type=FULLTEXT
  key=vidx_mem seq=1 column=embedding type=VECTOR
  key=idx_owner_status seq=1 column=owner_id type=BTREE
  key=idx_owner_status seq=2 column=status type=BTREE

== schema: ledger ==
CREATE TABLE `ledger` (
  `id` bigint(20) NOT NULL AUTO_INCREMENT,
  `owner_id` varchar(64) NOT NULL,
  `turn_id` varchar(64) DEFAULT NULL,
  `delta` int(11) NOT NULL,
  `reason` varchar(160) NOT NULL,
  `memory_id` bigint(20) DEFAULT NULL,
  `created_at` datetime DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_owner_turn` (`owner_id`, `turn_id`) BLOCK_SIZE 16384 LOCAL,
  KEY `idx_owner` (`owner_id`) BLOCK_SIZE 16384 LOCAL
) ORGANIZATION INDEX AUTO_INCREMENT = 47 DEFAULT CHARSET = utf8mb4 ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0

