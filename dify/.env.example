# seekdb connection (the app creates the `memory_pawnshop` database itself)
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=change-me
SEEKDB_DATABASE=memory_pawnshop

# HTTP service that Dify calls from its HTTP Request nodes
PAWNSHOP_HOST=127.0.0.1
PAWNSHOP_PORT=8700

# Every /api/* call must carry this value in X-Pawnshop-Token. Change it in
# .env and in both DSL files (HTTP node headers) together.
PAWNSHOP_API_TOKEN=change-me-pawnshop-token

# Embedding backend: fastembed (semantic, baked into the Docker image) or hash
# (lexical fallback for a machine that cannot download the model).
PAWNSHOP_EMBED_BACKEND=fastembed
PAWNSHOP_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PAWNSHOP_MODEL_CACHE=./.models
