# seekdb connection (the app creates the `memory_pawnshop` database itself)
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=memory_pawnshop

# HTTP service that Dify calls from its HTTP Request nodes
PAWNSHOP_HOST=127.0.0.1
PAWNSHOP_PORT=8700

# Embedding backend: hash (default, offline, no download) or fastembed
PAWNSHOP_EMBED_BACKEND=hash
# Only used when PAWNSHOP_EMBED_BACKEND=fastembed (install requirements-fastembed.txt)
PAWNSHOP_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PAWNSHOP_MODEL_CACHE=./.models

PAWNSHOP_START_COINS=120
PAWNSHOP_DREAM_COST=10
