  "decisions": {
    "active": [
      {
        "id": "ADR-007",
        "title": "金额比较使用 Decimal 闭区间并要求显式币种",
        "kind": "decision",
        "status": "active",
        "module": "order-query",
        "tags": [
          "amount",
          "decimal",
          "inclusive",
          "currency"
        ],
        "applies_to": [],
        "verified_by": [],
        "supersedes": [
          "ADR-003"
        ],
        "superseded_by": "",
        "affects": [
          "REQ-ORD-014"
        ],
        "body": "金额必须以 `decimal.Decimal` 解析并比较，区间为闭区间；查询方必须显式给出 `currency`，服务端不做\n任何默认币种推断。理由：金额是财务数据，`float` 的二进制表示无法精确表达两位小数；闭区间与对账口径\n（`min <= amount <= max`）一致；显式币种可以避免把 USD 订单混入 CNY 区间统计。",
        "source": "specs/decisions.md#L18",
        "revision": "20b3693d35144faa7848b93565f25d5d41483d6a0d4d86f39de27696773c505b"
      },
      {
        "id": "ADR-011",
        "title": "未知请求字段保持静默忽略",
        "kind": "decision",
        "status": "active",
        "module": "order-query",
        "tags": [
          "compatibility",
          "contract",
          "payload"
        ],
        "applies_to": [],
        "verified_by": [],
        "supersedes": [],
        "superseded_by": "",
        "affects": [
          "REQ-ORD-004"
        ],
        "body": "新增筛选项时不为未知字段引入严格校验：老客户端可能携带服务端尚未识别的字段，静默忽略可以保证升级期间\n不发生 4xx。该决策只约束“未知字段”，不约束已定义字段的取值校验。",
        "source": "specs/decisions.md#L31",
        "revision": "645183a38aca37c64e8de847c823d58f9e569ac2eea0e3c6690f6837f68bee8f"
      }
