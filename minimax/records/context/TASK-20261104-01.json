      "supersedes": [],
      "superseded_by": "",
      "affects": [],
      "body": "验证必须同时包含目标功能测试与回归测试：目标测试覆盖闭区间边界、单侧区间、币种隔离、精度比较与\n错误码；回归测试覆盖既有筛选、排序、分页与未知字段兼容。修改不得删除或跳过任何既有断言。",
      "source": "specs/order-query.md#L86",
      "revision": "ea5f650240a979ecc3d24164619d0e6fca18ddb887676632c19c46adceb6e494"
    },
    {
      "id": "CTR-ORD-001",
      "title": "搜索接口的错误响应",
      "kind": "contract",
      "status": "active",
      "module": "order-query",
      "tags": [
        "error",
        "contract",
        "http",
        "response"
      ],
